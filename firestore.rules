rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE CHECKS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin']) ||
        (request.auth.token.role in ['admin', 'Admin']) ||
        (request.auth.token.email == 'admin@royalcollege.edu.pk')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'Teacher', 'faculty']) ||
        (request.auth.token.role in ['teacher', 'Teacher', 'faculty']) ||
        (request.auth.token.email in [
          'dr.tariq@royalcollege.edu.pk',
          'maryam.saeed@royalcollege.edu.pk',
          'dr.usman@royalcollege.edu.pk',
          'dr.sanaullah@royalcollege.edu.pk'
        ]) ||
        (request.auth.token.email.matches('dr\\..*@royalcollege\\.edu\\.pk') ||
         request.auth.token.email.matches('prof\\..*@royalcollege\\.edu\\.pk'))
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student')
      );
    }


    // =========================================================================
    // USERS COLLECTION (Common identity metadata)
    // =========================================================================
    match /users/{userId} {
      // User can read their own identity record; Admins can read all users; Teachers can read user names/emails
      allow read: if isOwner(userId) || isTeacher() || isAdmin();
      
      // User can create their initial user doc on registration (student) or initial faculty setup; Admin can create any user doc
      allow create: if (isOwner(userId) && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role in ['teacher', 'Teacher', 'faculty'] && isTeacher())
      )) || isAdmin();
        
      // User can update their own non-role fields; Admins can update any user doc
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      
      // Only Admins can delete users
      allow delete: if isAdmin();
    }

    // =========================================================================
    // STUDENTS COLLECTION
    // =========================================================================
    match /students/{studentId} {
      // Student can read own profile; Teachers & Admins can read student profiles
      allow read: if isOwner(studentId) || isTeacher() || isAdmin();
      
      // Student can create their own student profile during registration
      allow create: if (isOwner(studentId) && request.resource.data.role == 'student') || isAdmin();
      
      // Student can update own profile (cannot change role); Admins can update
      allow update: if (isOwner(studentId) && request.resource.data.role == resource.data.role) || isAdmin();
      
      // Only Admins can delete student records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // KMU REGISTRATION UNIQUE REGISTRY
    // =========================================================================
    match /kmuRegistrations/{normalizedKmuReg} {
      // Allow single document read for KMU login resolution and pre-registration check
      allow get: if true;
      // Prevent unauthenticated scraping of all students
      allow list: if isAuthenticated() && (isTeacher() || isAdmin());
      
      // Created on registration by the authenticated owning user
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
        
      // Only Admin or the owning student can update/delete their KMU registration claim
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // =========================================================================
    // SYSTEM SETTINGS COLLECTION
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // TEACHERS COLLECTION
    // =========================================================================
    match /teachers/{teacherId} {
      // Teachers can read own profile; Admins can read all; Students can read basic teacher info
      allow read: if isOwner(teacherId) || isAdmin() || isStudent();
      
      // Authorized teachers can initialize their own profile; Admins can create or delete any teacher
      allow create: if (isOwner(teacherId) && isTeacher()) || isAdmin();
      allow delete: if isAdmin();
      
      // Teacher can update own profile; Admin can update any teacher
      allow update: if isOwner(teacherId) || isAdmin();
    }

    // =========================================================================
    // ADMINS COLLECTION
    // =========================================================================
    match /admins/{adminId} {
      // Users can check their own admin identity; Admins have full access
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // EXAMS COLLECTION
    // =========================================================================
    match /exams/{examId} {
      // Students can read scheduled/active exams; Teachers can read their own exams; Admins can read all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.teacherId == request.auth.token.email ||
          (request.auth.token.email == 'dr.tariq@royalcollege.edu.pk' && resource.data.teacherId == 'teacher-1')
        )) ||
        (isStudent() && (resource.data.status in ['scheduled', 'active', 'completed']))
      );
      
      // Teachers can create exams where teacherId matches their UID or email; Admins can create any exam
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          request.resource.data.teacherId == request.auth.uid ||
          request.resource.data.teacherId == request.auth.token.email
        ))
      );
      
      // Teachers can update their own exams; Admins can update any exam
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.teacherId == request.auth.token.email ||
          (request.auth.token.email == 'dr.tariq@royalcollege.edu.pk' && resource.data.teacherId == 'teacher-1')
        ))
      );
      
      // Teachers can delete their own draft exams; Admins can delete any exam
      allow delete: if isAdmin() || (isTeacher() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.teacherId == request.auth.token.email ||
        (request.auth.token.email == 'dr.tariq@royalcollege.edu.pk' && resource.data.teacherId == 'teacher-1')
      ));
    }

    // =========================================================================
    // QUESTIONS COLLECTION (Protected Question Bank & Answer Keys)
    // =========================================================================
    match /questions/{questionId} {
      // Master Question Bank & Answer Keys: ONLY Faculty and Admins can read or write directly.
      // Students NEVER receive raw question documents via Firestore client SDK.
      // Students receive sanitized questions exclusively via the getStudentExamQuestions Cloud Function.
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // WRITTEN QUESTIONS COLLECTION (Protected Short & Long Questions & Rubrics)
    // =========================================================================
    match /writtenQuestions/{questionId} {
      // Master Written Questions Bank & Rubrics: ONLY Faculty and Admins can read or write directly.
      // Students NEVER receive raw written question documents with internal rubrics via Firestore client SDK.
      // Students receive sanitized questions exclusively via exams/{examId}.sanitizedWrittenQuestions.
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // ASSIGNMENTS COLLECTION
    // =========================================================================
    match /assignments/{assignmentId} {
      // Student can read own assignments; Teachers & Admins can read all relevant assignments
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      
      // Teachers and Admins can assign exams to students;
      // Backend Cloud Functions manage automated candidate enrollment via Firebase Admin SDK.
      // Strict payload validation guarantees studentId, examId, status, and assignment authority.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isTeacher() &&
          request.resource.data.examId is string &&
          request.resource.data.examId.size() > 0 &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.status in ['assigned', 'started'] &&
          (request.resource.data.assignedBy == request.auth.uid ||
           request.resource.data.assignedBy == request.auth.token.email ||
           request.resource.data.assignedBy == 'teacher-1' ||
           isAdmin())
        )
      );
      
      // Student can update their own in-progress assignment attempt without modifying immutable metadata or scoring fields;
      // Teachers and Admins have full update access for assignment administration and grading
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (
          isStudent() &&
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.examId == resource.data.examId &&
          resource.data.status in ['assigned', 'started'] &&
          request.resource.data.status in ['started', 'submitted'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers',
            'answersCount',
            'writtenAnswers',
            'writtenAnswersCount',
            'status',
            'startedAt',
            'submittedAt',
            'studentName',
            'kmuRegistrationNo',
            'examTitle',
            'examType',
            'subject',
            'totalMarks',
            'batch',
            'semester',
            'program'
          ])
        )
      );
      
      allow delete: if isAdmin() || isTeacher();
    }

    // =========================================================================
    // RESULTS COLLECTION (Authoritative Examination Records)
    // =========================================================================
    match /results/{resultId} {
      // Student can read own results; Teachers & Admins can read all results
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      
      // CRITICAL: Students CANNOT directly create, modify, or forge examination results.
      // All result calculation, grading, and document creation must be performed
      // server-side by Firebase Cloud Functions using the Firebase Admin SDK.
      // Only Faculty and Admins can record or regrade results directly.
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isTeacher());
    }
  }
}
