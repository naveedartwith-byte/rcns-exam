rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE CHECKS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'ADMIN']) ||
        (request.auth.token.role in ['admin', 'Admin', 'ADMIN']) ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('(?i)admin@royalcollege\\.edu\\.pk') ||
          request.auth.token.email.matches('(?i)naveedartwith@gmail\\.com')
        ))
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
           'teacher', 'Teacher', 'TEACHER', 'faculty', 'Faculty', 'FACULTY', 'instructor', 'Instructor'
         ]) ||
        (request.auth.token.role in [
           'teacher', 'Teacher', 'TEACHER', 'faculty', 'Faculty', 'FACULTY', 'instructor', 'Instructor'
        ]) ||
        (request.auth.token.email != null && !isStudent() && (
          request.auth.token.email.matches('(?i).*@royalcollege\\.edu\\.pk') ||
          request.auth.token.email in [
            'dr.tariq@royalcollege.edu.pk',
            'maryam.saeed@royalcollege.edu.pk',
            'dr.usman@royalcollege.edu.pk',
            'dr.sanaullah@royalcollege.edu.pk'
          ] ||
          request.auth.token.email.matches('(?i)(dr\\.tariq|maryam\\.saeed|dr\\.usman|dr\\.sanaullah).*@royalcollege\\.edu\\.pk') ||
          request.auth.token.email.matches('(?i)(dr\\.|prof\\.|teacher|faculty).*')
        ))
      );
    }

    // =========================================================================
    // USERS COLLECTION (Common identity metadata)
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacher() || isAdmin();
      
      allow create: if (isOwner(userId) && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role in ['teacher', 'Teacher', 'TEACHER', 'faculty', 'Faculty', 'FACULTY', 'instructor', 'Instructor'] && (
          isTeacher() ||
          (request.auth.token.email != null && (
            request.auth.token.email.matches('(?i)(dr\\.|prof\\.|teacher|faculty).*') ||
            request.auth.token.email.matches('(?i).*@royalcollege\\.edu\\.pk')
          ))
        ))
      )) || isAdmin();
        
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // STUDENTS COLLECTION
    // =========================================================================
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isTeacher() || isAdmin();
      allow create: if (isOwner(studentId) && request.resource.data.role == 'student') || isAdmin();
      allow update: if (isOwner(studentId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // KMU REGISTRATION UNIQUE REGISTRY
    // =========================================================================
    match /kmuRegistrations/{normalizedKmuReg} {
      allow get: if true;
      allow list: if isAuthenticated() && (isTeacher() || isAdmin());
      allow create: if isAuthenticated() &&
        (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // =========================================================================
    // SYSTEM SETTINGS COLLECTION
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // TEACHERS COLLECTION
    // =========================================================================
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin() || isStudent();
      allow create: if (isOwner(teacherId) && (
        isTeacher() ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('(?i)(dr\\.|prof\\.|teacher|faculty).*') ||
          request.auth.token.email.matches('(?i).*@royalcollege\\.edu\\.pk')
        ))
      )) || isAdmin();
      allow delete: if isAdmin();
      allow update: if isOwner(teacherId) || isAdmin();
    }

    // =========================================================================
    // ADMINS COLLECTION
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // EXAMS COLLECTION
    // =========================================================================
    match /exams/{examId} {
      // Normal students cannot read drafts or archived exams.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.teacherId == request.auth.token.email ||
          resource.data.teacherId in ['teacher-1', 'teacher-2', 'teacher-3', 'teacher-4'] ||
          (request.auth.token.email != null && (
            request.auth.token.email.matches('(?i)dr\\.tariq@royalcollege\\.edu\\.pk') ||
            request.auth.token.email.matches('(?i)maryam\\.saeed@royalcollege\\.edu\\.pk') ||
            request.auth.token.email.matches('(?i)dr\\.usman@royalcollege\\.edu\\.pk') ||
            request.auth.token.email.matches('(?i)dr\\.sanaullah@royalcollege\\.edu\\.pk')
          ))
        )) ||
        (
          isStudent() &&
          resource.data.status in ['scheduled', 'active', 'completed']
        )
      );
      
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          request.resource.data.teacherId == request.auth.uid ||
          request.resource.data.teacherId == request.auth.token.email ||
          request.resource.data.teacherId in ['teacher-1', 'teacher-2', 'teacher-3', 'teacher-4']
        ))
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.teacherId == request.auth.token.email ||
          resource.data.teacherId in ['teacher-1', 'teacher-2', 'teacher-3', 'teacher-4'] ||
          (request.auth.token.email != null && request.auth.token.email.matches('(?i)dr\\.tariq@royalcollege\\.edu\\.pk') && resource.data.teacherId == 'teacher-1')
        ))
      );
      
      allow delete: if isAdmin() || (isTeacher() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.teacherId == request.auth.token.email ||
        resource.data.teacherId in ['teacher-1', 'teacher-2', 'teacher-3', 'teacher-4']
      ));
    }

    // =========================================================================
    // EXAM SECRETS COLLECTION (Institutional Secret Exam Codes)
    // =========================================================================
    match /examSecrets/{examId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // EXAM CODE RATE LIMITS COLLECTION (Brute-Force Lockouts)
    // =========================================================================
    match /examCodeRateLimits/{limitId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // EXAM CODE HASHES (Public Cryptographic Verification Tokens for Spark Tier)
    // =========================================================================
    match /examCodeHashes/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // QUESTIONS COLLECTION (Protected Question Bank & Answer Keys)
    // =========================================================================
    match /questions/{questionId} {
      // ONLY Faculty and Admins can read or write master questions with answer keys.
      // Students have ZERO read or write access under all circumstances.
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // WRITTEN QUESTIONS COLLECTION (Protected Short & Long Questions & Rubrics)
    // =========================================================================
    match /writtenQuestions/{questionId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // ASSIGNMENTS COLLECTION
    // =========================================================================
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (
          isStudent() &&
          resource.data.studentId == request.auth.uid
        )
      );
      
      // Teachers & Admins can create assignments for candidates.
      // Students can initialize their own assignment record when starting an authorized examination.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isTeacher() &&
          request.resource.data.examId is string &&
          request.resource.data.examId.size() > 0 &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.status in ['assigned', 'started'] &&
          (request.resource.data.assignedBy == request.auth.uid ||
           request.resource.data.assignedBy == request.auth.token.email ||
           request.resource.data.assignedBy in ['teacher-1', 'teacher-2', 'teacher-3', 'teacher-4', 'system-cohort-sync'] ||
           isAdmin())
        ) ||
        (
          isStudent() &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status in ['assigned', 'started'] &&
          !request.resource.data.keys().hasAny([
            'marks', 'obtainedMarks', 'mcqMarks', 'writtenMarks',
            'shortQuestionsMarks', 'longQuestionsMarks', 'grade',
            'percentage', 'passed', 'evaluatedBy', 'writtenEvaluations', 'gradedAt',
            'isLocked', 'lockedAt', 'lockedBy', 'lockedByName', 'lockedByRole', 'lockReason', 'lockAuditTrail'
          ])
        )
      );
      
      // Student can update only their own existing in-progress assignment attempt.
      // Metadata (studentName, kmuRegistrationNo, examTitle, examType, subject, totalMarks, batch, semester, program)
      // are immutable by students. Secret code verification tokens & testing progress can be recorded.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (
          isStudent() &&
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.examId == resource.data.examId &&
          (!('assignedBy' in resource.data) || request.resource.data.assignedBy == resource.data.assignedBy) &&
          (!('assignedAt' in resource.data) || request.resource.data.assignedAt == resource.data.assignedAt) &&
          (!('studentName' in resource.data) || request.resource.data.studentName == resource.data.studentName) &&
          (!('kmuRegistrationNo' in resource.data) || request.resource.data.kmuRegistrationNo == resource.data.kmuRegistrationNo) &&
          (!('examTitle' in resource.data) || request.resource.data.examTitle == resource.data.examTitle) &&
          (!('examType' in resource.data) || request.resource.data.examType == resource.data.examType) &&
          (!('subject' in resource.data) || request.resource.data.subject == resource.data.subject) &&
          (!('totalMarks' in resource.data) || request.resource.data.totalMarks == resource.data.totalMarks) &&
          (!('batch' in resource.data) || request.resource.data.batch == resource.data.batch) &&
          (!('semester' in resource.data) || request.resource.data.semester == resource.data.semester) &&
          (!('program' in resource.data) || request.resource.data.program == resource.data.program) &&
          ((resource.data.status == 'assigned' && request.resource.data.status in ['assigned', 'started']) ||
           (resource.data.status == 'started' && request.resource.data.status in ['started', 'submitted'])) &&
          (!('isLocked' in resource.data) || resource.data.isLocked != true) &&
          !request.resource.data.keys().hasAny([
            'marks', 'obtainedMarks', 'mcqMarks', 'writtenMarks',
            'shortQuestionsMarks', 'longQuestionsMarks', 'grade',
            'percentage', 'passed', 'evaluatedBy', 'writtenEvaluations', 'gradedAt',
            'isLocked', 'lockedAt', 'lockedBy', 'lockedByName', 'lockedByRole', 'lockReason', 'lockAuditTrail'
          ]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers',
            'answersCount',
            'writtenAnswers',
            'writtenAnswersCount',
            'status',
            'startedAt',
            'lastActiveAt',
            'submittedAt',
            'tabSwitchCount',
            'timeLeftSeconds',
            'currentQuestionIndex',
            'activeExamSection',
            'flaggedQuestions',
            'attemptId',
            'codeVerified',
            'codeVerifiedAt'
          ])
        )
      );
      
      allow delete: if isAdmin() || isTeacher();
    }

    // =========================================================================
    // EXAM LOCK AUDITS (Teacher/Admin Proctoring Audit Log)
    // =========================================================================
    match /examLockAudits/{auditId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isTeacher());
    }

    // =========================================================================
    // RESULTS COLLECTION (Authoritative Examination Records)
    // =========================================================================
    match /results/{resultId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (
          isStudent() &&
          resource.data.studentId == request.auth.uid
        )
      );
      
      // ONLY authorized Teachers & Admins can publish or update official examination results.
      // Students have ZERO create or update permission on the results collection.
      allow create, update: if isAuthenticated() && (isAdmin() || isTeacher());
      allow delete: if isAuthenticated() && (isAdmin() || isTeacher());
    }
  }
}
